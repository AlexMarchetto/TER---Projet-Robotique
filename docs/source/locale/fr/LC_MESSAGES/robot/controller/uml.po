#: ../../source/robot/controller/uml.rst:3
msgid "UML Diagram"
msgstr "Diagramme UML"

#: ../../source/robot/controller/uml.rst:5
msgid "This page presents the object-oriented modeling of the robot controller."
msgstr "Cette page présente la modélisation orientée objet du contrôleur du robot."

#: ../../source/robot/controller/uml.rst:7
msgid "The modeling is mainly based on composition:"
msgstr "La modélisation repose principalement sur la composition :"

#: ../../source/robot/controller/uml.rst:9
msgid "``TERBot`` owns the main robot subsystems."
msgstr "``TERBot`` possède les sous-systèmes principaux du robot."

#: ../../source/robot/controller/uml.rst:10
msgid "``DriveBase`` owns four wheels."
msgstr "``DriveBase`` possède quatre roues."

#: ../../source/robot/controller/uml.rst:11
msgid "``Wheel`` encapsulates a Webots motor."
msgstr "``Wheel`` encapsule un moteur Webots."

#: ../../source/robot/controller/uml.rst:12
msgid "``RobotSensors`` encapsulates the sensors."
msgstr "``RobotSensors`` encapsule les capteurs."

#: ../../source/robot/controller/uml.rst:13
#: ../../source/robot/controller/uml.rst:179
msgid "``Arm`` encapsulates the arm and gripper motors."
msgstr "``Arm`` encapsule les moteurs du bras et de la pince."

#: ../../source/robot/controller/uml.rst:14
msgid "``PuckManager`` encapsulates puck management."
msgstr "``PuckManager`` encapsule la gestion des palets."

#: ../../source/robot/controller/uml.rst:18
msgid "PlantUML Diagram"
msgstr "Diagramme PlantUML"

#: ../../source/robot/controller/uml.rst:20
msgid "The following diagram can be copied into a PlantUML-compatible tool."
msgstr ""
"Le diagramme suivant peut être copié dans un outil compatible PlantUML."

#: ../../source/robot/controller/uml.rst:166
msgid "Main relationships"
msgstr "Relations principales"

#: ../../source/robot/controller/uml.rst:168
msgid "``FourWheelsCollisionAvoidance`` creates ``TERBot``."
msgstr "``FourWheelsCollisionAvoidance`` crée ``TERBot``."

#: ../../source/robot/controller/uml.rst:170
msgid ""
"``TERBot`` owns ``DriveBase``, ``RobotSensors``, ``Arm`` and "
"``PuckManager``."
msgstr ""
"``TERBot`` possède ``DriveBase``, ``RobotSensors``, ``Arm`` et "
"``PuckManager``."

#: ../../source/robot/controller/uml.rst:173
msgid "``DriveBase`` owns four ``Wheel`` objects."
msgstr "``DriveBase`` possède quatre objets ``Wheel``."

#: ../../source/robot/controller/uml.rst:175
msgid "``Wheel`` encapsulates a Webots ``Motor``."
msgstr "``Wheel`` encapsule un ``Motor`` Webots."

#: ../../source/robot/controller/uml.rst:177
msgid "``RobotSensors`` encapsulates the Webots sensors."
msgstr "``RobotSensors`` encapsule les capteurs Webots."

#: ../../source/robot/controller/uml.rst:181
msgid "``PuckManager`` encapsulates data related to pucks."
msgstr "``PuckManager`` encapsule les données liées aux palets."